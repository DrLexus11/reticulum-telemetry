# Copy to deploy/prod/.env on the production host; never commit .env.
# The address Grafana listens on: the host's tailnet address, so it is
# reachable from the tailnet and nowhere else. 127.0.0.1 keeps it local.
GRAFANA_BIND=127.0.0.1
# Grafana's admin password. deploy/prod/deploy.sh generates one if unset.
GRAFANA_ADMIN_PASSWORD=
