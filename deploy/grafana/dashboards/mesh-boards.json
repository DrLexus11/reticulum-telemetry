      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Restarts (crashes + panics, lifetime)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
