{
  "uid": "mesh-boards",
  "title": "Mesh boards",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "mesh"
  ],
  "panels": [
    {
      "id": 100,
      "type": "alertlist",
      "title": "Fleet alerts -- firing and pending",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": false,
          "error": true
        }
      }
    },
    {
      "id": 1,
      "type": "table",
      "title": "Boards -- one row each, latest report",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - mesh_board_report_received_timestamp_seconds",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "mesh_board_uptime_seconds",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "mesh_board_heap_free_bytes",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "mesh_board_heap_largest_block_bytes",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "mesh_board_crashes",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "mesh_board_panics",
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "mesh_board_hops_to_gateway",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "sender": "Board",
              "Value #A": "Last report (s ago)",
              "Value #B": "Uptime",
              "Value #C": "Heap free",
              "Value #D": "Largest block",
              "Value #E": "Crashes",
              "Value #F": "Panics",
              "Value #G": "Hops"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Heap free"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Largest block"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last report (s ago)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 600
                    },
                    {
                      "color": "red",
                      "value": 1200
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Heap free",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mesh_board_heap_free_bytes",
          "legendFormat": "{{sender}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Largest free block",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mesh_board_heap_largest_block_bytes",
          "legendFormat": "{{sender}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Restarts (crashes + panics)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mesh_board_crashes + mesh_board_panics",
          "legendFormat": "{{sender}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Carriers up",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mesh_board_interface_up == 1",
          "legendFormat": "{{sender}} {{interface}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Paths and nodes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mesh_board_paths",
          "legendFormat": "{{sender}} paths"
        },
        {
          "refId": "B",
          "expr": "mesh_board_nodes",
          "legendFormat": "{{sender}} nodes"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Time since last report",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - mesh_board_report_received_timestamp_seconds",
          "legendFormat": "{{sender}}"
        }
      ]
    }
  ]
}
