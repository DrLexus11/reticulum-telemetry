# The telemetry backend: subscribes to mesh/telemetry/# and serves Prometheus
# metrics on 127.0.0.1:9101. Installed by deploy/install-services.sh.
[Unit]
Description=Reticulum telemetry backend (MQTT -> Prometheus)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/reticulum-telemetry-backend
Restart=always
RestartSec=10
# In the logs folder the log collector reads (deploy/alloy); install-services.sh
# creates it -- systemd opens this file before any command of the unit runs.
StandardOutput=append:%h/.impr-tak/logs/telemetry-backend.log
StandardError=inherit

[Install]
WantedBy=default.target
