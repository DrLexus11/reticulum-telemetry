# The telemetry gateway: announces rnstransport.telemetry.uplink and publishes
# each report to MQTT. Installed by deploy/install-services.sh.
[Unit]
Description=Reticulum telemetry gateway (mesh -> MQTT)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/projects/reticulum-telemetry
# GATEWAY_NAME lives in this host's own file, never in the repository.
EnvironmentFile=%E/reticulum-telemetry/gateway.env
ExecStart=%h/.local/share/rnode-rns-venv/bin/python -u gateway/telemetry_gateway.py --identity %h/.impr-tak/telemetry-gateway/identity --name ${GATEWAY_NAME}
Restart=always
RestartSec=10
StandardOutput=append:%h/.impr-tak/telemetry-gateway.log
StandardError=inherit

[Install]
WantedBy=default.target
